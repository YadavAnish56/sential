# ==========================================
# Sentinel CCTV API — Environment Variables
# ==========================================

# Database
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_password@127.0.0.1:5433/sentinel

# Streaming / Camera Catalogue
RTSP_CATALOG_URL=https://cctv.corp8.cloud/cameras.json
RTSP_CATALOG_TOKEN=
RTSP_TRANSPORT=tcp

# Government Camera Gateway (Gujarat CCTV Network)
WHEP_GATEWAY_URL=http://103.250.160.189:8889
RTSP_GATEWAY_URL=rtsp://103.250.160.189:8554
RTSP_USER=
RTSP_PASSWORD=

# AI / Detection
AI_MODEL_PATH=models/yolov8n.pt
ANPR_MODEL_PATH=models/license_plate_detector.pt
DETECTION_CONFIDENCE=0.40
ANPR_CONFIDENCE=0.70

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Debug mode
DEBUG=false
