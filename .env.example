# ==========================================
# Sentinel CCTV API — Environment Variables
# ==========================================

# Database
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_password@127.0.0.1:5433/sentinel

# Streaming / Camera Catalogue
RTSP_CATALOG_URL=http://live.corp8.cloud/api/ingest
RTSP_TRANSPORT=tcp

# AI / Detection
AI_MODEL_PATH=models/yolov8n.pt
ANPR_MODEL_PATH=models/anpr.pt
DETECTION_CONFIDENCE=0.40
ANPR_CONFIDENCE=0.70

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug mode
DEBUG=false
